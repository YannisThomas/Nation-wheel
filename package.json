{
  "name": "nation-wheel-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulateur géopolitique multi-agents piloté par LLM local, inspiré de Nation Wheel",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/run-sim.ts",
    "start": "npm run build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "setup": "tsx scripts/setup.ts",
    "build": "node scripts/build-web.mjs",
    "examples": "tsx scripts/make-examples.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}